# Copy this file to .env, then change the password before running Compose.
# SQL Server requires at least 8 characters with 3 of 4 character groups:
# uppercase, lowercase, numbers, and symbols.
MSSQL_SA_PASSWORD=ChangeThis_StrongPass2026!

# Host port for SQL Server. 14330 avoids conflict with a local SQL Server on 1433.
SQLSERVER_PORT=14330
