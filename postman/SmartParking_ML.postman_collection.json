		{
			"name": "1. Backend (.NET) - PlateScans API",
			"description": "Các endpoint nghiệp vụ của SmartParking.Api (.NET) kết nối SQL Server.",
			"item": [
				{
					"name": "Create Plate Scan",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response has created PlateScan fields', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json).to.have.property('scanId');",
									"    pm.expect(json).to.have.property('plate');",
									"    pm.expect(json).to.have.property('confidence');",
									"    pm.expect(json).to.have.property('createdAt');",
									"    if (json.scanId) {",
									"        pm.collectionVariables.set('scanId', String(json.scanId));",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"plate\": \"51F-123.45\",\n  \"confidence\": 0.96,\n  \"imagePath\": \"/scan-image/20261128_140000_plate.jpg\",\n  \"cropImagePath\": \"/scan-image/20261128_140000_crop.jpg\",\n  \"plateColorCode\": \"White\",\n  \"plateColorLabel\": \"Biển trắng (Xe cá nhân)\",\n  \"plateColorConfidence\": 0.94,\n  \"scanTime\": \"2026-11-28T14:00:00\",\n  \"note\": \"PaddleOCR | Biển trắng (Xe cá nhân)\",\n  \"colorCode\": \"White\"\n}",
