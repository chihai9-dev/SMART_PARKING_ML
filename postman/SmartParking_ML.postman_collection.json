									"    if (json.length > 0) {",
									"        pm.expect(json[0]).to.have.property('scanId');",
									"        pm.expect(json[0]).to.have.property('plate');",
									"        pm.collectionVariables.set('scanId', String(json[0].scanId));",
									"    }",
									"});"
