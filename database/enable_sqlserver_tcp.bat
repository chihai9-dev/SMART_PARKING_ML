@echo off
title Bat Che Do Mixed Mode va Port 1433 cho SQL Server
echo Dang cau hinh Mixed Mode (SQL Authentication) va khoi dong lai SQL Server...

powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process powershell -Verb RunAs -ArgumentList '-NoProfile -ExecutionPolicy Bypass -Command \"Set-ItemProperty -Path ''HKLM:\SOFTWARE\Microsoft\Microsoft SQL Server\MSSQL16.SQLEXPRESS04\MSSQLServer'' -Name ''LoginMode'' -Value 2; Set-ItemProperty -Path ''HKLM:\SOFTWARE\Microsoft\Microsoft SQL Server\MSSQL16.SQLEXPRESS04\MSSQLServer\SuperSocketNetLib\Tcp'' -Name ''Enabled'' -Value 1; Set-ItemProperty -Path ''HKLM:\SOFTWARE\Microsoft\Microsoft SQL Server\MSSQL16.SQLEXPRESS04\MSSQLServer\SuperSocketNetLib\Tcp\IPAll'' -Name ''TcpPort'' -Value ''1433''; Set-ItemProperty -Path ''HKLM:\SOFTWARE\Microsoft\Microsoft SQL Server\MSSQL16.SQLEXPRESS04\MSSQLServer\SuperSocketNetLib\Tcp\IPAll'' -Name ''TcpDynamicPorts'' -Value ''''; Restart-Service -Name ''MSSQL$SQLEXPRESS04''; Write-Host ''[OK] Da bat che do Mixed Mode (tai khoan sa) va khoi dong lai SQL Server thanh cong!'' -ForegroundColor Green; Write-Host ''Ban co the dong cua so nay va bam Connect tren VS Code.'' -ForegroundColor Cyan; Start-Sleep -Seconds 5\"'"
